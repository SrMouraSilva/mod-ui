{
  "name": "modui-plugin-view",
  "version": "0.1.0",
  "description": "Renders and drives the GUI (modgui) of MOD plugins in any web page, on top of modui-client: icon, settings, knobs, switches and the plugins' own scripts.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./global": "./dist/modui-plugin-view.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mod-audio",
    "mod-ui",
    "lv2",
    "modgui",
    "plugin",
    "audio"
  ],
  "homepage": "https://github.com/mod-audio/mod-ui/blob/master/docs/modui-plugin-view.md",
  "bugs": "https://github.com/mod-audio/mod-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mod-audio/mod-ui.git",
    "directory": "modui-plugin-view"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "modui-client": "*"
  },
  "peerDependenciesMeta": {
    "modui-client": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node build.mjs global",
    "watch": "node build.mjs global --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:js": "node build.mjs lib",
    "build:types": "tsc -p tsconfig.build.json && node ../tools/add-dts-extensions.mjs dist",
    "build:lib": "npm run clean && npm run build:js && npm run build:types",
    "prepack": "node -e \"require('node:fs').copyFileSync('../LICENSE', 'LICENSE')\"",
    "prepublishOnly": "npm test && npm run build:lib"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "happy-dom": "21.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
